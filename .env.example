# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# Supabase → botón "Connect" o Project Settings → API Keys. Son públicas (RLS protege
# los datos). Nunca pongas acá la secret key. Sin estas dos, la hoja guarda solo en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexión directa a Postgres para Drizzle (fase 3). Supabase → "Connect" → ORMs / connection string
DATABASE_URL=
